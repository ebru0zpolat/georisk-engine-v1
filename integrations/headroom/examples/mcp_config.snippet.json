{
  "mcpServers": {
    "georisk-engine": {
      "enabled": true,
      "type": "stdio",
      "command": "georisk-mcp",
      "env": {
        "GEORISK_BASE_URL": "http://127.0.0.1:8002",
        "GEORISK_MCP_COMPRESS": "0"
      }
    },
    "headroom": {
      "enabled": true,
      "type": "stdio",
      "command": "headroom",
      "args": ["mcp", "serve"]
    }
  }
}
