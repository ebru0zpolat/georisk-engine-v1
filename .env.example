# App
# local / dev / test / demo: labelled connector stubs permitted (data_mode=stub).
# production: missing ORAS5_ZARR_URL / GEE live config fails closed at startup.
APP_ENV=local
# Data-centre assess endpoint (contract GET is always available). Default off.
# Enabling never releases downtime hours or monetary/EAL outputs.
# DATA_CENTRE_ASSESS_ENABLED=false
APP_NAME=GeoRisk Engine
API_PREFIX=/v1
# JSON array preferred in production (see AGENTS.md). Comma-separated also accepted.
CORS_ORIGINS=["http://localhost:5173","https://georiskengine.com","https://www.georiskengine.com"]
# HTTPS Vercel preview hosts only (Starlette fullmatch; empty/none disables).
# CORS_ORIGIN_REGEX=https://([a-zA-Z0-9-]+\.)+vercel\.app

# Deploy provenance for GET /v1/health (git_sha). Prefer explicit GIT_SHA;
# Railway also injects RAILWAY_GIT_COMMIT_SHA automatically when unset.
# GIT_SHA=
# RAILWAY_GIT_COMMIT_SHA=

# Controlled-pilot release secrets belong in the GitHub `controlled-pilot`
# environment, never in this file: PILOT_BASE_URL, CONTROLLED_PILOT_TOKEN,
# RAILWAY_TOKEN, RAILWAY_SERVICE_ID, PILOT_EVIDENCE_BUCKET,
# PILOT_EVIDENCE_AWS_ROLE_ARN, and PILOT_EVIDENCE_AWS_REGION.

# Public API guards (demo Railway)
# PORTFOLIO_UPLOAD_MAX_BYTES=2000000
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW_SECONDS=60
# On Railway: honour X-Forwarded-For only from private/CGNAT edge peers (rightmost walk).
# TRUST_PRIVATE_PROXY_PEERS=true includes RFC1918 + loopback + link-local + 100.64.0.0/10.
# TRUST_PRIVATE_PROXY_PEERS=true
# TRUSTED_PROXY_IPS=
# X-Real-IP is a SEPARATE opt-in (default false). TRUSTED_PROXY_IPS alone must NOT
# enable it — only turn on after confirming the edge overwrites/strips inbound
# client X-Real-IP. Railway production (if edge sets X-Real-IP to the client):
# TRUST_PRIVATE_PROXY_PEERS=true AND TRUST_X_REAL_IP=true
# TRUST_X_REAL_IP=false

# ORAS5 (CDS ARCO/Zarr)
# Set this to the Zarr store URL from CDS "Analysis Ready Data"
ORAS5_ZARR_URL=

# Climate / GEE (optional overrides for climatological baseline)
# Defaults: WMO 1991–2020 (~30-year reference) for current vs baseline comparisons
# CLIMATE_BASELINE_START=1991-01-01
# CLIMATE_BASELINE_END=2020-12-31

# Google Earth Engine (audit scripts accept GEE_PROJECT or GEE_PROJECT_ID)
GEE_PROJECT=
GEE_PROJECT_ID=
GEE_ENABLED=false

# Closed-loop distribution (deployment hints — enforce at reverse proxy / IdP)
# AUDIENCE_DASHBOARD_ALLOWLIST_CSV=203.0.113.0/24,198.51.100.10
# GEORISK_REPORT_WATERMARK=ACME-Corp-MarketAlpha-NDA-2026-Q2

# Risk API: max distance (km) to attach nearest Primary Audit facility when include_industrial_verification_ref=true
# INDUSTRIAL_VERIFICATION_MAX_MATCH_KM=40

# DeerFlow / MCP client (integrations/deerflow — not used by FastAPI server)
# GEORISK_BASE_URL=http://127.0.0.1:8002
# GEORISK_TIMEOUT_SECONDS=60
# GEORISK_API_KEY=

# Headroom × georisk-mcp (integrations/headroom — optional token compression)
# GEORISK_MCP_COMPRESS=1
# GEORISK_MCP_COMPRESS_MIN_TOKENS=800
# GEORISK_MCP_COMPRESS_TARGET_RATIO=0.5
# GEORISK_MCP_COMPRESS_MODEL=claude-sonnet-4-5-20250929

# UC-01 preview scorecard: optional Nominatim for free-text addresses
# GEORISK_GEOCODER=nominatim

# Copernicus Climate Data Store (GEO-191 reads COPERNICUS_CDS_API_KEY or CDSAPI_KEY)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=your-cds-api-key
# COPERNICUS_CDS_API_KEY=

# Case management — Supabase PostgreSQL (GEO-72)
# DATABASE_URL=postgresql+asyncpg://postgres:password@db.<project-ref>.supabase.co:5432/postgres
# Asset snapshot store: unset -> "db" when DATABASE_URL is set, else "memory" (test fixture only).
# SNAPSHOT_STORE_BACKEND=db
